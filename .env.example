# Raksha Kavach - Factory Safety AI Configuration
# Host & Networking
HOST=0.0.0.0
PORT=8000

# Webhook notification URL (Slack Incoming Webhook, Discord Webhook, or custom HTTP endpoint)
SLACK_WEBHOOK_URL=

# Rate-limiting cooldown in seconds per zone & violation type (prevents alert spam)
ALERT_COOLDOWN_SECONDS=60

# Frame sampling rate (process every Nth frame: 1 = full fidelity, 3 = edge compute throttling)
FRAME_SAMPLE_RATE=1

# Model confidence thresholds
PPE_CONFIDENCE_THRESHOLD=0.30
FIRE_CONFIDENCE_THRESHOLD=0.25

# Temporal filtering (consecutive positive detections required to trigger alert, suppresses single-frame transients)
TEMPORAL_WINDOW_FRAMES=3

# DPDP Act 2023 & Privacy Controls
FACE_BLURRING_ENABLED=true
INCIDENT_RETENTION_DAYS=30

# Cloud Multi-Level Vision AI Keys (Optional - Asynchronous Post-Incident Reports)
GROQ_API_KEY=
GEMINI_API_KEY=

