# Raksha Kavach - Factory Safety AI Configuration
# Webhook notification URL (Slack Incoming Webhook, Discord Webhook, or custom HTTP endpoint)
SLACK_WEBHOOK_URL=

# Rate-limiting cooldown in seconds per zone & violation type (prevents alert spam)
ALERT_COOLDOWN_SECONDS=60

# Frame sampling rate (process every Nth frame: 1 = every frame, 3 = every 3rd frame)
FRAME_SAMPLE_RATE=3

# Model confidence thresholds
PPE_CONFIDENCE_THRESHOLD=0.45
FIRE_CONFIDENCE_THRESHOLD=0.50

# Temporal filtering (consecutive positive detections required to trigger alert)
TEMPORAL_WINDOW_FRAMES=4
